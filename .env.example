# =============================================================================
# ADFIR Platform — Environment Configuration Template
# Copy this file to .env and fill in all values before running the platform.
# NEVER commit the real .env file to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application Environment
# Options: development | testing | production
# ---------------------------------------------------------------------------
FLASK_ENV=development

# The host and port the Flask dev server listens on.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# ---------------------------------------------------------------------------
# Security Keys
# In production, generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------

# Flask session signing key — change before deploying.
SECRET_KEY=CHANGE_ME_generate_a_random_64char_hex_string

# JWT signing key — must be different from SECRET_KEY.
JWT_SECRET_KEY=CHANGE_ME_generate_a_different_random_64char_hex_string

# AES-256 master key for evidence encryption (hex-encoded, exactly 64 hex chars = 32 bytes).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AES_MASTER_KEY=CHANGE_ME_generate_exactly_64_hex_chars_here_for_AES256

# ---------------------------------------------------------------------------
# PostgreSQL Database
# ---------------------------------------------------------------------------

# Primary application database.
DATABASE_URL=postgresql://adfir_user:adfir_pass@localhost:5432/adfir_db

# Test database (used when FLASK_ENV=testing).
TEST_DATABASE_URL=postgresql://adfir_user:adfir_pass@localhost:5432/adfir_test_db

# ---------------------------------------------------------------------------
# Storage Paths (relative to project root)
# ---------------------------------------------------------------------------

# Where encrypted evidence artifacts are written to disk.
EVIDENCE_STORAGE_PATH=data/evidence

# Where generated report files (HTML, JSON, PDF) are stored.
REPORTS_STORAGE_PATH=data/reports

# Where the simulated lab state files live (synthetic asset registry, etc.).
LAB_DATA_PATH=data/lab

# ---------------------------------------------------------------------------
# Detection Engine
# ---------------------------------------------------------------------------

# How often (seconds) the scheduler polls for unprocessed raw events.
DETECTION_POLL_INTERVAL_SECONDS=5

# How long (seconds) a new DetectionHit can correlate with an open incident.
CORRELATION_WINDOW_SECONDS=1800

# ---------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ---------------------------------------------------------------------------
# Logging
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
