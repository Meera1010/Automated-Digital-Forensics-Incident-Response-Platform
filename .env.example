# =============================================================================
# ADFIR Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#
# NEVER commit .env — it is gitignored for your safety.
# =============================================================================

# --- Flask Application -------------------------------------------------------
# Environment: development | testing | production
FLASK_ENV=development

# Flask secret key — used for session signing.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_64_char_hex_string

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://adfir_user:adfir_pass@localhost:5432/adfir_db

# Test database (used by pytest). Defaults to SQLite in-memory if unset.
# TEST_DATABASE_URL=sqlite:///:memory:

# --- JWT Authentication ------------------------------------------------------
# Secret key for signing JWT access tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_64_char_hex_string

# --- Evidence Vault (AES-256-GCM) --------------------------------------------
# 64 hex characters = 32 bytes. Used as the master encryption key.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AES_MASTER_KEY=CHANGE_ME_generate_a_64_char_hex_string

# --- CORS (Cross-Origin Resource Sharing) ------------------------------------
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# --- File Storage Paths ------------------------------------------------------
# Relative to project root. Created automatically on startup.
EVIDENCE_STORAGE_PATH=data/evidence
REPORTS_STORAGE_PATH=data/reports
LAB_DATA_PATH=data/lab

# --- Detection Engine --------------------------------------------------------
# Poll interval in seconds for new unprocessed events.
DETECTION_POLL_INTERVAL_SECONDS=5

# Time window (seconds) for correlating hits into an incident.
CORRELATION_WINDOW_SECONDS=1800

# Enable/disable background scheduler (set to False for testing).
SCHEDULER_ENABLED=True

# --- Logging -----------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
